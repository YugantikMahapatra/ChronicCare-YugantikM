<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell2"
            app:tint="#26A69A"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvPermissionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/permissions_message"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Step 1: Overlay -->
        <LinearLayout
            android:id="@+id/step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/iconStep1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_unchecked" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Over Other Apps"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needed to show alarms on lock screen"
                    android:textSize="12sp"
                    android:textColor="#777777" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrant1"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant" />
        </LinearLayout>

        <!-- Step 2: Alarms -->
        <LinearLayout
            android:id="@+id/step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/iconStep2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_unchecked" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarms &amp; Reminders"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needed for precise notification timing"
                    android:textSize="12sp"
                    android:textColor="#777777" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrant2"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant" />
        </LinearLayout>

        <!-- Step 3: Battery -->
        <LinearLayout
            android:id="@+id/step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/iconStep3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_unchecked" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ignore Battery Optimization"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ensures alarms run in background"
                    android:textSize="12sp"
                    android:textColor="#777777" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrant3"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDonePermissions"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="All Set! Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#26A69A" />

    </LinearLayout>
</ScrollView>
